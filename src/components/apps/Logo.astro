---
// The Local Lab mark: an Erlenmeyer flask on an emerald tile. Kept in sync with
// assets/favicon.svg (the favicon and app icons are generated from that file).
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg
  class="lab-logo"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="lab-logo-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#10b981"></stop>
      <stop offset="1" stop-color="#047857"></stop>
    </linearGradient>
    <clipPath id="lab-logo-flask">
      <path d="M26 12h12v14.5l11.4 20.6c1.6 2.9-.5 6.4-3.8 6.4H18.4c-3.3 0-5.4-3.5-3.8-6.4L26 26.5z"></path>
    </clipPath>
  </defs>
  <rect x="2" y="2" width="60" height="60" rx="15" fill="url(#lab-logo-bg)"></rect>
  <g clip-path="url(#lab-logo-flask)">
    <path d="M10 40c5-3 9 3 14 0s9-3 14 0 9 3 16 0V60H10z" fill="#ecfdf5"></path>
  </g>
  <path
    d="M26 12h12v14.5l11.4 20.6c1.6 2.9-.5 6.4-3.8 6.4H18.4c-3.3 0-5.4-3.5-3.8-6.4L26 26.5z"
    fill="none"
    stroke="#fff"
    stroke-width="3.2"
    stroke-linejoin="round"></path>
  <path d="M23 12h18" stroke="#fff" stroke-width="3.2" stroke-linecap="round"></path>
  <circle cx="28.5" cy="46" r="2.3" fill="#059669"></circle>
  <circle cx="36.5" cy="48.5" r="1.7" fill="#059669"></circle>
  <circle cx="33" cy="42.5" r="1.4" fill="#059669"></circle>
  <circle cx="46" cy="14" r="2.6" fill="#fde68a"></circle>
  <circle cx="51.5" cy="20.5" r="1.6" fill="#fde68a"></circle>
</svg>
