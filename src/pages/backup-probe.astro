---
/*
 * Unlisted test page for the folder-backup plan (see src/lib/apps/backup-probe.ts). Not in the tools
 * registry, the sitemap or search results; delete it once the plan is settled.
 */
import { withBase } from "@/lib/apps/paths";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <title>Backup probe — Local Lab</title>
  </head>
  <body>
    <main data-probe>
      <h1>Backup probe</h1>
      <p>
        Tests whether this browser can keep writing a backup into a folder you pick once. Pick a folder (for example
        a new <code>LocalLab</code> folder in Documents), then reload, close the browser, restart the phone, switch
        apps and come back, and finally clear this site's data and pick the same folder again. Each visit is logged
        below. When done, tap “Copy report”.
      </p>
      <p data-status>Starting…</p>
      <div class="actions">
        <button type="button" data-action="pick">Pick folder</button>
        <button type="button" data-action="allow" hidden>Allow again</button>
        <button type="button" data-action="write">Write now</button>
        <button type="button" data-action="list">List folder</button>
        <button type="button" data-action="abort">Aborted-write test</button>
        <button type="button" data-action="saveas">Save-as test</button>
        <button type="button" data-action="persist">Ask to persist storage</button>
        <button type="button" data-action="forget">Forget folder</button>
        <button type="button" data-action="copy">Copy report</button>
        <button type="button" data-action="clearlog">Clear log</button>
      </div>
      <pre data-log></pre>
    </main>
    <script>
      import { startProbe } from "@/lib/apps/backup-probe";

      startProbe(document.querySelector<HTMLElement>("[data-probe]")!);
    </script>
    <style>
      :root {
        color-scheme: light dark;
        font-family: system-ui, sans-serif;
      }
      body {
        margin: 0;
        padding: 1rem;
      }
      main {
        max-width: 48rem;
        margin: 0 auto;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      button {
        font: inherit;
        padding: 0.6rem 0.9rem;
        min-height: 44px;
      }
      pre {
        white-space: pre-wrap;
        word-break: break-word;
        font-size: 0.8rem;
        padding: 0.75rem;
        border: 1px solid currentColor;
        border-radius: 6px;
      }
    </style>
  </body>
</html>
