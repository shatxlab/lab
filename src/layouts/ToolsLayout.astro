---
import "@/styles/apps.css";
import ThemePrePaint from "@/components/apps/ThemePrePaint.astro";
import LangPrePaint from "@/components/apps/LangPrePaint.astro";
import ThemeToggle from "@/components/apps/ThemeToggle";
import LangToggle from "@/components/apps/LangToggle";
import CommandPalette from "@/components/apps/CommandPalette";
import SettingsButton from "@/components/apps/SettingsButton";
import PwaRegister from "@/components/apps/PwaRegister";
import Logo from "@/components/apps/Logo.astro";
import { withBase } from "@/lib/apps/paths";
import { BRAND, pageTitle } from "@/lib/brand";
import { TOOLS } from "@/lib/apps/tools";

interface Props {
  /** Registry id of the tool this page is for; drives the title, description and structured data. */
  tool?: string;
  lang?: string;
}

const { tool: toolId, lang = "en" } = Astro.props;
const tool = TOOLS.find((entry) => entry.id === toolId);

const title = tool ? pageTitle(tool.seo.title) : BRAND.homeTitle;
const description = tool ? tool.seo.description : BRAND.description;
const site = Astro.site ?? new URL("https://example.com");
const canonical = new URL(Astro.url.pathname, site).href;
const image = new URL(withBase("/og-image.png"), site).href;

// Structured data helps search engines show the right thing; it is plain JSON, not executable.
const structuredData = tool
  ? {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: `${tool.title.en} — ${BRAND.name}`,
      description,
      url: canonical,
      applicationCategory: tool.category === "games" ? "GameApplication" : "UtilitiesApplication",
      operatingSystem: "Any (web browser)",
      browserRequirements: "Requires a modern web browser",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      inLanguage: ["en", "ru"],
      isPartOf: { "@type": "WebSite", name: BRAND.name, url: new URL(withBase("/"), site).href },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: BRAND.name,
      alternateName: BRAND.tagline.en,
      description,
      url: canonical,
      inLanguage: ["en", "ru"],
    };
---


<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="theme-color" content={BRAND.themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={BRAND.themeColor.dark} media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${BRAND.name} — ${BRAND.tagline.en}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="manifest" href={withBase("/manifest.webmanifest")} />
    <link rel="apple-touch-icon" href={withBase("/icons/apple-touch-icon.png")} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={BRAND.name} />
    <meta name="application-name" content={BRAND.name} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>{title}</title>
    <ThemePrePaint />
    <LangPrePaint />
  </head>
  <body class="flex min-h-screen flex-col bg-(--bg) text-(--fg) antialiased">
    <a href="#main" class="skip-link"><span class="skip-en">Skip to content</span><span class="skip-ru">К содержимому</span></a>
    <div class="flex min-h-0 flex-1 flex-col">
      <header
        class="lab-header sticky top-0 z-50 flex h-[58px] shrink-0 items-center justify-between gap-4 border-b border-(--border) px-[18px] backdrop-blur"
      >
        <a
          href={withBase("/")}
          class="lab-wordmark inline-flex items-center gap-2.5 no-underline text-sm uppercase tracking-[0.3em] text-(--fg) transition-colors hover:text-(--accent)"
          aria-label={`${BRAND.name} — home`}
        >
          <Logo size={30} />
          <span class="lab-wordmark-text">{BRAND.name}</span>
        </a>
        <div class="flex shrink-0 items-center gap-2.5">
          <CommandPalette client:load />
          <SettingsButton client:load />
          <LangToggle client:load />
          <ThemeToggle client:load />
        </div>
      </header>

      <!--
        Local-first by construction: every tool on /tools opens, parses and
        renders files entirely in your browser. Your files stay on your device.
      -->

      <main id="main" tabindex="-1" class="flex min-h-0 flex-1 flex-col focus:outline-none">
        <slot />
      </main>
    </div>
    <PwaRegister client:idle />
  </body>
</html>
